@PACKAGE_INIT@

set(SeqPro_VERSION "@PROJECT_VERSION@")

include("${CMAKE_CURRENT_LIST_DIR}/SeqProTargets.cmake")

set(SeqPro_SequenceText_FOUND FALSE)
if("SequenceText" IN_LIST SeqPro_FIND_COMPONENTS)
  set(_seqpro_sequence_text_targets
      "${CMAKE_CURRENT_LIST_DIR}/SeqProSequenceTextTargets.cmake")
  if(EXISTS "${_seqpro_sequence_text_targets}")
    include("${_seqpro_sequence_text_targets}")
    set(SeqPro_SequenceText_FOUND TRUE)
  else()
    if(SeqPro_FIND_REQUIRED_SequenceText)
      set(SeqPro_NOT_FOUND_MESSAGE
          "The requested SeqPro SequenceText component was not built or installed")
    endif()
  endif()
  unset(_seqpro_sequence_text_targets)
endif()

check_required_components(SeqPro)
