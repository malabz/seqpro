PROJECT_NAME           = "SeqPro"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Indexed FASTA access and optional sequence-text layouts"
OUTPUT_DIRECTORY       = "@SEQPRO_DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
INPUT                   = @SEQPRO_DOXYGEN_INPUTS@
FILE_PATTERNS           = *.h *.md
RECURSIVE               = NO
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE  = @PROJECT_SOURCE_DIR@/docs/getting_started.md
EXCLUDE                 =
EXCLUDE_PATTERNS        = */internal/*
SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO
GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_LATEX          = NO
GENERATE_XML            = NO
QUIET                   = YES
HAVE_DOT                = NO
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = YES
PREDEFINED              = SEQPRO_EXPORT= \
                          SEQPRO_NO_EXPORT= \
                          SEQPRO_SEQUENCE_TEXT_EXPORT=
SKIP_FUNCTION_MACROS    = YES
