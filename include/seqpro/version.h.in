#ifndef SEQPRO_INCLUDE_SEQPRO_VERSION_H_
#define SEQPRO_INCLUDE_SEQPRO_VERSION_H_

#include <string_view>

#define SEQPRO_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define SEQPRO_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define SEQPRO_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define SEQPRO_VERSION_STRING "@PROJECT_VERSION@"

namespace seqpro {

/// Major component of the configured SeqPro version.
inline constexpr int kVersionMajor = SEQPRO_VERSION_MAJOR;
/// Minor component of the configured SeqPro version.
inline constexpr int kVersionMinor = SEQPRO_VERSION_MINOR;
/// Patch component of the configured SeqPro version.
inline constexpr int kVersionPatch = SEQPRO_VERSION_PATCH;
/// Complete configured SeqPro version as `major.minor.patch`.
inline constexpr std::string_view kVersionString = SEQPRO_VERSION_STRING;

}  // namespace seqpro

#endif  // SEQPRO_INCLUDE_SEQPRO_VERSION_H_
